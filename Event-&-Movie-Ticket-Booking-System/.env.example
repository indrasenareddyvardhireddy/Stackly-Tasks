# ---- Database (MySQL) ----
DATABASE_URL=mysql+pymysql://root:your_password@localhost:3306/ticket_booking

# ---- Redis ----
REDIS_URL=redis://localhost:6379/0

# ---- JWT / QR secrets (use long random strings) ----
JWT_SECRET_KEY=change-this-to-a-long-random-string
QR_SECRET_KEY=change-this-too-for-signing-qr-codes

# ---- SMTP (leave SMTP_HOST empty to only log emails to the console) ----
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASSWORD=your_app_password
SMTP_FROM=Ticket Booking <your_email@gmail.com>
SMTP_USE_TLS=true

# ---- Razorpay (TEST mode keys from the Razorpay dashboard; optional) ----
RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxxxx
RAZORPAY_KEY_SECRET=your_razorpay_test_secret
RAZORPAY_WEBHOOK_SECRET=your_webhook_secret_set_in_dashboard
