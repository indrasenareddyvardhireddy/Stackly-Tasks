# Copy to .env and fill in real values. Never commit .env.
DATABASE_URL=mysql+aiomysql://root:password@localhost:3306/support_tickets?charset=utf8mb4
JWT_SECRET_KEY=change-me-to-a-long-random-string
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# Optional (bonus): email notifications. Leave SMTP_HOST empty to disable.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=support@example.com
SMTP_USE_TLS=true
