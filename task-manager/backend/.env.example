SECRET_KEY=change-me-to-a-long-random-string
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1
FRONTEND_URL=http://localhost:5173
TIME_ZONE=Asia/Kolkata

# MySQL
DB_NAME=task_manager
DB_USER=root
DB_PASSWORD=your-mysql-password
DB_HOST=127.0.0.1
DB_PORT=3306

# Set True to use SQLite instead of MySQL (handy for quick tests)
USE_SQLITE=False

# JWT lifetimes (shorten ACCESS_TOKEN_MINUTES to 1 for the refresh demo)
ACCESS_TOKEN_MINUTES=30
REFRESH_TOKEN_DAYS=1

# Email (reminders). Console backend prints emails to the terminal.
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
DEFAULT_FROM_EMAIL=reminders@taskmanager.local
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=True
