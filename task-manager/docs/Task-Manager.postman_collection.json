        },
        {
          "name": "List tasks (filters)",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/tasks/?status=To Do&priority=High&due=overdue&ordering=due_date&search=report&page=1",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "tasks"
              ],
              "query": [
                {
                  "key": "status",
                  "value": "To Do"
                },
                {
                  "key": "priority",
                  "value": "High"
                },
                {
                  "key": "due",
                  "value": "overdue"
                },
                {
                  "key": "ordering",
                  "value": "due_date"
                },
                {
                  "key": "search",
                  "value": "report"
                },
                {
                  "key": "page",
                  "value": "1"
                }
              ]
            },
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{access}}",
                  "type": "string"
                }
              ]
            }
          }
        },
