# ---- Database (MySQL) ----
DATABASE_URL=mysql+pymysql://root:password@localhost:3306/wallet_db

# ---- JWT ----
JWT_SECRET_KEY=change-me-to-a-long-random-string
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# ---- SMTP (leave SMTP_HOST empty to only log emails to the console) ----
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASSWORD=your-app-password
SMTP_FROM=Wallet App <your-email@gmail.com>
SMTP_USE_TLS=true

# ---- Seed admin (created at startup if missing; Admin cannot self-register) ----
ADMIN_EMAIL=admin@wallet.local
ADMIN_PASSWORD=Admin@12345
ADMIN_PHONE=9000000000
ADMIN_NAME=Platform Admin

# ---- Misc ----
STATEMENTS_DIR=statements
# DEV ONLY: return the OTP in the /otp/send response so you can test without SMTP
DEBUG_RETURN_OTP=true
ENABLE_SCHEDULER=true
